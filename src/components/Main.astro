---
import background from "../assets/Main/fondo-mantel.webp";
import { fade } from "astro:transitions";
import Tarjeta from "../components/Tarjetas/tarjeta.jsx";
import Tablero from "../components/Tablero.astro";
---

<div class="container" id="app" transition:animate={fade({ duration: "1s" })}>
    <img id="background" src={background.src} alt="" fetchpriority="high" />
    <main>
        <div id="mesa">
            <Tarjeta
                idSeccion="info"
                client:load
                id="tarjeta-izq"
                rotacion="90deg"
            />
            <div id="tablero-wrapper">
                <Tablero />
                <div id="tarjeta-centro">
                    <Tarjeta idSeccion="MV" client:load rotacion="0deg" />
                </div>
            </div>
            <Tarjeta
                idSeccion="spoti"
                client:load
                id="tarjeta-der"
                rotacion="-90deg"
            />
        </div>
    </main>
    <div class="candle-overlay" fetchpriority="high"></div>
</div>

<style>
    #app {
        opacity: 0;
        transition: opacity 1.5s ease;
    }
    #app.loaded {
        opacity: 1;
    }
    body {
        background-color: black;
    }

    main {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    #background {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 100vw;
        z-index: -4;
    }
    #mesa {
        height: auto;
        display: grid;
        grid-template-areas: "izq tablero der";
        align-items: center;
    }

    #tarjeta-izq {
        grid-area: izq;
        --rotacion: rotate(90deg);
    }

    #tarjeta-der {
        grid-area: der;
        --rotacion: rotate(-90deg);
    }

    #tablero-wrapper {
        grid-area: tablero;
        position: relative;
    }

    #tarjeta-centro {
        z-index: 0;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .candle-overlay {
        position: fixed;
        /* Mantenemos el margen de seguridad para evitar bordes blancos */
        top: -2%;
        left: -2%;
        width: 104%;
        height: 104%;
        pointer-events: none;
        z-index: 100;

        /* Gradiente más amplio: la luz llega más lejos antes de oscurecerse */
        background: radial-gradient(
            circle at 50% 50%,
            rgba(255, 140, 20, 0.23) 0%,
            /* Centro cálido */ rgba(30, 15, 5, 0.35) 40%,
            /* La luz se mantiene clara por más espacio */ rgba(10, 5, 0, 0.75)
                50%,
            /* Oscuridad sutil cerca del borde */ rgba(0, 0, 0, 0.95) 100%
                /* Negro total solo en el extremo final */
        );

        mix-blend-mode: overlay;

        /* Animación ruidosa pero con movimiento reducido */
        animation: candle-flicker-subtle 4s infinite;
    }

    @keyframes candle-flicker-subtle {
        0%,
        100% {
            opacity: 0.88;
            transform: scale(1) translate(0, 0);
        }
        /* Los saltos son de apenas 1 o 2 píxeles para que sea ruido y no desplazamiento */
        7% {
            opacity: 0.94;
            transform: scale(1.005) translate(1px, -1px);
        }
        15% {
            opacity: 0.9;
            transform: scale(1) translate(-1px, 0.5px);
        }
        25% {
            opacity: 0.82;
            transform: scale(1) translate(-1px, 0.5px);
        }
        35% {
            opacity: 0.86;
            transform: scale(1) translate(-1px, 0.5px);
        }
        45% {
            opacity: 0.82;
            transform: scale(1.002) translate(0, 0);
        }
        50% {
            opacity: 0.8; /* Un pequeño bajón de luz orgánico */
        }
        53% {
            opacity: 0.88;
            transform: scale(1.008) translate(0.5px, 1px);
        }
        63% {
            opacity: 0.83;
            transform: scale(1.008) translate(0.5px, 1px);
        }
        73% {
            opacity: 0.9;
            transform: scale(1.008) translate(0.5px, 1px);
        }
        80% {
            opacity: 0.86;
            transform: scale(1) translate(-0.5px, -0.5px);
        }
        92% {
            opacity: 0.82;
            transform: scale(1.008) translate(0.5px, 1px);
        }
    }
</style>

<script>
    import { isTransitionBeforePreparationEvent } from "astro:transitions/client";

    function mostrar() {
        setTimeout(() => {
            document.getElementById("app")?.classList.add("loaded");
        }, 300);
    }

    // Para carga inicial normal
    window.addEventListener("load", mostrar);

    // Para cuando llegás via View Transition
    document.addEventListener("astro:page-load", mostrar);
</script>
