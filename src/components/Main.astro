---
import LottieAnimation from "astro-integration-lottie/Lottie.astro";
import background from "../assets/Main/fondo-mantel.png";
import tablero from "../assets/Main/tablero.png";
import tarjeta from "../assets/Main/tarjeta.svg";
import { fade } from "astro:transitions";
import Seccion from "../components/Secciones/seccion.jsx";
---

<div class="container" transition:animate={fade({ duration: "1s" })}>
    <img id="background" src={background.src} alt="" fetchpriority="high" />
    <main>
        <div class="tarjeta">
            <img
                id="tarjeta-izq"
                src={tarjeta.src}
                alt=""
                fetchpriority="high"
            />
        </div>
        <div id="tablero">
            <img src={tablero.src} alt="" fetchpriority="high" />
            <!-- <div style="width: 200px; height: 150px;">
        <LottieAnimation src="/lottie-lego.json" autoplay="visible" />
    </div> -->
        </div>
        <div class="tarjeta">
            <img
                id="tarjeta-der"
                src={tarjeta.src}
                alt=""
                fetchpriority="high"
            />
        </div>
    </main>
    <Seccion />
</div>

<style>
    body {
        background-color: black;
    }

    main {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        filter: blur(0px);
    }

    #background {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        z-index: -2;
        filter: blur(0px);
    }
    #tablero {
        height: auto;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    #tablero img {
        height: 90vh;
        filter: blur(0px);
    }

    .tarjeta img {
        height: 20vh;
        width: auto;
        --escala: 1;
        transform: var(--rotacion, rotate(0deg)) scale(var(--escala));
        transition-duration: 0.3s;
    }

    .tarjeta img:hover {
        --escala: 1.05;
        filter: drop-shadow(0 0 5px rgba(232, 217, 102, 1));
    }

    #tarjeta-izq {
        --rotacion: rotate(90deg);
    }

    #tarjeta-der {
        --rotacion: rotate(-90deg);
    }
</style>
