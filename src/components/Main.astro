---
import { fade } from "astro:transitions";
import Tarjeta from "../components/Tarjetas/tarjeta.jsx";
import Ficha from "../components/Fichas/ficha.jsx";
import Tablero from "../components/Tablero/Tablero.astro";
---

<div class="container" id="app" transition:animate={fade({ duration: "1s" })}>
    <img
        id="background"
        src="/fondo-mantel.webp"
        alt=""
        loading="eager"
        fetchpriority="high"
    />
    <main>
        <div id="mesa">
            <div id="izq">
                <Tarjeta
                    idSeccion="spoti"
                    id="tarjeta-izq"
                    rotacion="90deg"
                    client:visible
                />
                <Ficha idSeccion="bruja" id="bruja" client:visible />
            </div>
            <div id="tablero-wrapper">
                <Tablero />
                <div id="tarjeta-centro">
                    <Tarjeta idSeccion="MV" rotacion="0deg" client:visible />
                </div>
            </div>
            <div id="der">
                <Tarjeta
                    idSeccion="info"
                    id="tarjeta-der"
                    rotacion="-90deg"
                    client:visible
                />
                <Ficha idSeccion="brujo" id="brujo" client:visible />
            </div>
        </div>
    </main>
    <div class="candle-overlay" fetchpriority="high"></div>
</div>

<style>
    #app {
        opacity: 0;
        transition: opacity 1.5s ease;
    }
    #app.loaded {
        opacity: 1;
    }
    body {
        background-color: black;
    }

    main {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    #background {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 100vw;
        z-index: -4;
    }
    #mesa {
        height: auto;
        display: grid;
        grid-template-areas: "izq tablero der";
        align-items: center;
    }

    #izq {
        grid-area: izq;
        position: relative;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    #der {
        grid-area: der;
    }

    #tarjeta-izq {
        --rotacion: rotate(90deg);
    }

    #tarjeta-der {
        --rotacion: rotate(-90deg);
    }

    #brujo {
        position: fixed;
        top: 60vh;
        right: 6vw;
    }

    #tablero-wrapper {
        grid-area: tablero;
        position: relative;
    }

    #tarjeta-centro {
        z-index: 0;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .candle-overlay {
        position: fixed;
        top: -2%;
        left: -2%;
        width: 104%;
        height: 104%;
        pointer-events: none;
        z-index: 100;

        background: radial-gradient(
            circle at 50% 50%,
            rgba(255, 135, 15, 0.32) 0%,
            /* Centro más cálido */ rgba(30, 15, 5, 0.42) 45%,
            /* Penumbra intermedia */ rgba(10, 5, 0, 0.65) 60%,
            rgba(0, 0, 0, 0.96) 100% /* Viñeta final */
        );

        mix-blend-mode: overlay;
        animation: candle-flicker-subtle 4s infinite;
    }

    @keyframes candle-flicker-subtle {
        0%,
        100% {
            opacity: 0.85;
            transform: scale(1) translate(0, 0);
        }
        7% {
            opacity: 0.98;
            transform: scale(1.006) translate(1px, -1px);
        }
        15% {
            opacity: 0.88;
            transform: scale(0.995) translate(-1px, 0.5px);
        }
        25% {
            opacity: 0.74;
            transform: scale(1) translate(-1px, 0.5px);
        }
        35% {
            opacity: 0.92;
            transform: scale(1.002) translate(1px, 0.5px);
        }
        45% {
            opacity: 0.78;
            transform: scale(1) translate(-0.5px, -0.5px);
        }
        50% {
            opacity: 0.68;
            transform: scale(0.992) translate(0, 0);
        }
        54% {
            opacity: 0.95;
            transform: scale(1.008) translate(0.5px, 1px);
        }
        65% {
            opacity: 0.82;
            transform: scale(1) translate(-1px, -0.5px);
        }
        78% {
            opacity: 1;
            transform: scale(1.01) translate(1px, 1px);
        }
        88% {
            opacity: 0.84;
            transform: scale(0.997) translate(-0.5px, -0.5px);
        }
        94% {
            opacity: 0.76;
            transform: scale(1) translate(0.5px, 1px);
        }
    }
</style>

<script>
    import { isTransitionBeforePreparationEvent } from "astro:transitions/client";

    function mostrar() {
        setTimeout(() => {
            document.getElementById("app")?.classList.add("loaded");
        }, 300);
    }

    // Para carga inicial normal
    window.addEventListener("load", mostrar);

    // Para cuando llegás via View Transition
    document.addEventListener("astro:page-load", mostrar);
</script>
