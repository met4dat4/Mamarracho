---
import LottieAnimation from "astro-integration-lottie/Lottie.astro";
import background from "../assets/Main/fondo-mantel.png";
import tablero from "../assets/Main/tablero.png";
import tarjeta from "../assets/Main/tarjeta.svg";
import { fade } from "astro:transitions";
import Seccion from "../components/Secciones/seccion.jsx";
import Tarjeta from "../components/Tarjetas/tarjeta.jsx";
---

<div class="container" transition:animate={fade({ duration: "1s" })}>
    <img id="background" src={background.src} alt="" fetchpriority="high" />
    <main>
        <div id="mesa">
            <img
                class="tablero"
                src={tablero.src}
                alt=""
                fetchpriority="high"
            />
            <Tarjeta
                idSeccion="info"
                client:load
                id="tarjeta-izq"
                rotacion="90deg"
            />
            <Tarjeta
                idSeccion="video"
                client:load
                id="tarjeta-der"
                rotacion="-90deg"
            />
            <!-- <div style="width: 200px; height: 150px;">
        <LottieAnimation src="/lottie-lego.json" autoplay="visible" />
    </div> -->
        </div>
    </main>
    <!-- <Seccion /> -->
</div>

<style>
    body {
        background-color: black;
    }

    main {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    #background {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 100vw;
        z-index: -2;
    }
    #mesa {
        height: auto;
        display: grid;
        grid-template-areas: "izq tablero der";
        align-items: center;
    }
    .tablero {
        height: 90vh;
        /*filter: blur(0px);*/
    }

    /*.tarjeta img {
        height: 20vh;
        width: auto;
        --escala: 1;
        transform: var(--rotacion, rotate(0deg)) scale(var(--escala));
        transition-duration: 0.3s;
    }

    .tarjeta img:hover {
        --escala: 1.05;
        filter: drop-shadow(0 0 5px rgba(232, 217, 102, 1));
    }*/

    .tablero {
        grid-area: tablero;
    }

    #tarjeta-izq {
        grid-area: izq;
        --rotacion: rotate(90deg);
    }

    #tarjeta-der {
        grid-area: der;
        --rotacion: rotate(-90deg);
    }
</style>
