---
import LottieAnimation from "astro-integration-lottie/Lottie.astro";
import background from "../assets/Main/fondo-mantel.png";
import tablero from "../assets/Main/tablero.png";
import tarjeta from "../assets/Main/tarjeta.svg";
import bolaBottom from "../assets/Casilleros/bola-bottom.png";
import { fade } from "astro:transitions";
import Seccion from "../components/Secciones/seccion.jsx";
import Tarjeta from "../components/Tarjetas/tarjeta.jsx";
import Tablero from "../components/Tablero.astro";
---

<div class="container" transition:animate={fade({ duration: "1s" })}>
    <img id="background" src={background.src} alt="" fetchpriority="high" />
    <main>
        <div id="mesa">
            <Tablero />
            <Tarjeta
                idSeccion="info"
                client:load
                id="tarjeta-izq"
                rotacion="90deg"
            />
            <Tarjeta
                idSeccion="video"
                client:load
                id="tarjeta-der"
                rotacion="-90deg"
            />
        </div>
    </main>
</div>

<style>
    body {
        background-color: black;
    }

    main {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    #background {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 100vw;
        z-index: -2;
    }
    #mesa {
        height: auto;
        display: grid;
        grid-template-areas: "izq tablero der";
        align-items: center;
    }

    #tarjeta-izq {
        grid-area: izq;
        --rotacion: rotate(90deg);
    }

    #tarjeta-der {
        grid-area: der;
        --rotacion: rotate(-90deg);
    }
</style>
