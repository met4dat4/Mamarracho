---
import manosLogo from "../assets/Manos.svg";
import { fade } from "astro:transitions";
import background from "../assets/frontpage background.webp";
---

<div
    id="container"
    transition:animate={fade({ duration: "1s", direction: "forward" })}
>
    <img
        id="background"
        src="/frontpage background.webp"
        alt=""
        loading="eager"
        fetchpriority="high"
    />
    <main>
        <section id="Inicio">
            <a id="Manos" href="/main" fetchpriority="high">
                <img
                    src="/Manos.webp"
                    alt="Mamarracho Homepage"
                    loading="eager"
                    fetchpriority="high"
                />
            </a>
        </section>
    </main>
</div>

<style>
    body {
        background-color: #3f133a;
    }
    #background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100dvw;
        height: 100dvh;
        z-index: -1;
    }

    #container {
        font-family:
            Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
            sans-serif;
        height: 100%;
    }

    main {
        height: 100dvh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    #Inicio {
        width: clamp(280px, 40vw, 1280px);
        margin-top: 10vh;
    }

    #Manos {
        display: block;
        width: 100%;
    }

    #Manos img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.3s ease;
        transition-duration: 0.4s;
    }

    #Manos img:hover {
        //box-shadow: 0 0 15px 5px rgba(255, 255, 255, 0.7); /* O filter: drop-shadow(...) */
        filter: drop-shadow(0 0 5px rgba(232, 217, 102, 1));

        transform: scale(1.02);
    }
</style>
