---
import tablero from "../assets/Main/tablero.webp";
import bolaBottom from "../assets/Casilleros/bola-bottom.webp";
import bolaUpper from "../assets/Casilleros/bola-upper.webp";
import calaveraUpper from "../assets/Casilleros/calavera-upper.webp";
import calaveraBottom from "../assets/Casilleros/calavera-bottom.webp";
import serpienteUpper from "../assets/Casilleros/serpiente-upper.webp";
import serpienteBottom from "../assets/Casilleros/serpiente-bottom.webp";
import libroBottom from "../assets/Casilleros/libro-bottom.webp";
import libroUpper from "../assets/Casilleros/libro-upper.webp";
---

<div class="tablero">
    <img
        class="tablero-background"
        src={tablero.src}
        alt=""
        fetchpriority="high"
    />
    <div class="grid-botones">
        <button class="casillero calavera-upper">
            <img src={calaveraUpper.src} alt="" />
        </button>
        <button class="casillero calavera-bottom">
            <img src={calaveraBottom.src} alt="" />
        </button>
        <button class="casillero bola-upper">
            <img src={bolaUpper.src} alt="" />
        </button>
        <button class="casillero bola-bottom">
            <img src={bolaBottom.src} alt="" />
        </button>
        <button class="casillero serpiente-upper">
            <img src={serpienteUpper.src} alt="" />
        </button>
        <button class="casillero serpiente-bottom">
            <img src={serpienteBottom.src} alt="" />
        </button>
        <button class="casillero libro-bottom">
            <img src={libroBottom.src} alt="" />
        </button>
        <button class="casillero libro-upper">
            <img src={libroUpper.src} alt="" />
        </button>
    </div>

    <style>
        .tablero {
            height: 90vh;
            grid-area: tablero;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .tablero-background {
            height: 100%;
            width: auto;
            max-width: 100%;
            object-fit: contain;
            display: block;
            z-index: -2;
        }

        .grid-botones {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
            margin: auto;

            aspect-ratio: 1 / 1;
            height: 100%;

            display: grid;
            grid-template-columns: repeat(6, 1fr);
            grid-template-rows: repeat(6, 1fr);

            overflow: visible;
            z-index: 0;
        }

        .casillero {
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: visible;
            z-index: 0;
        }

        .casillero img {
            width: 100%;
            height: auto;

            transition:
                transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275),
                filter 0.4s ease;

            backface-visibility: hidden;
            z-index: 0;

            image-rendering: crisp-edges;
            image-rendering: pixelated;
            transform: translateZ(0);
            will-change: transform;
        }

        .casillero:hover img {
            transform: scale(1.02);
            filter: drop-shadow(0 0 5px rgba(255, 195, 77, 1));
            z-index: 2;
        }

        .tarjeta {
            grid-column: 2/5;
            grid-row: 2/5;

            justify-self: center;
            align-self: end;

            width: 76%;
            height: auto;

            transform: translateY(-28%) translateX(21.7%);
        }

        .bola-upper {
            grid-column: 1/3;
            grid-row: 2/4;

            justify-self: center;
            align-self: end;

            width: 60%;
            height: auto;

            transform: translateY(-28%) translateX(5%);
        }

        .bola-bottom {
            grid-column: 3/5;
            grid-row: 5/7;

            justify-self: center;
            align-self: end;

            width: 50%;
            height: auto;

            transform: translateY(-27%) translateX(27%);
        }

        .calavera-upper {
            grid-column: 1/4;
            grid-row: 1/3;

            justify-self: center;
            align-self: end;

            width: 26%;
            height: auto;

            transform: translateY(-45%) translateX(-89%);
        }

        .calavera-bottom {
            grid-column: 1/4;
            grid-row: 4/7;

            justify-self: center;
            align-self: end;

            width: 39%;
            height: auto;

            transform: translateY(-40%) translateX(-40%);
        }

        .serpiente-upper {
            grid-column: 4/5;
            grid-row: 1/3;

            justify-self: center;
            align-self: end;

            width: 73.2%;
            height: auto;

            transform: translateY(-51.3%) translateX(10%);
        }

        .serpiente-bottom {
            grid-column: 6/7;
            grid-row: 3/4;

            justify-self: center;
            align-self: end;

            width: 116%;
            height: auto;

            transform: translateY(-25%) translateX(-26.8%);
        }

        .libro-bottom {
            grid-column: 6/7;
            grid-row: 6/7;

            justify-self: center;
            align-self: end;

            width: 116%;
            height: auto;

            transform: translateY(-60%) translateX(-26.8%);
        }

        .libro-upper {
            grid-column: 6/7;
            grid-row: 1/3;

            justify-self: center;
            align-self: end;

            width: 116%;
            height: auto;

            transform: translateY(-50%) translateX(-26.8%);
        }
    </style>
</div>
