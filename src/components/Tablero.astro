---
import tablero from "../assets/Main/tablero.png";
import bolaBottom from "../assets/Casilleros/bola-bottom.svg";
import bolaUpper from "../assets/Casilleros/bola-upper.svg";
---

<div class="tablero">
    <img
        class="tablero-background"
        src={tablero.src}
        alt=""
        fetchpriority="high"
    />
    <div class="grid-botones">
        <button class="casillero bola-bottom">
            <img src={bolaBottom.src} alt="" />
        </button>
        <button class="casillero bola-upper">
            <img src={bolaUpper.src} alt="" />
        </button>
    </div>
</div>

<style>
    .tablero {
        height: 90vh;
        grid-area: tablero;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .tablero-background {
        height: 100%;
        width: auto;
        max-width: 100%;
        object-fit: contain;
        display: block;
    }

    .grid-botones {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        margin: auto;

        aspect-ratio: 1 / 1;
        height: 100%;

        display: grid;
        grid-template-columns: repeat(6, 1fr);
        grid-template-rows: repeat(6, 1fr);

        z-index: 10;
    }

    .casillero {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: visible;
    }

    .casillero img {
        width: 100%;
        height: auto;

        transition:
            transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275),
            filter 0.4s ease;

        backface-visibility: hidden;
    }

    .bola-bottom {
        grid-column: 3/5;
        grid-row: 5/7;

        justify-self: center;
        align-self: end;

        width: 50%;
        height: auto;

        transform: translateY(-27%) translateX(27%);
    }

    .bola-upper {
        grid-column: 1/3;
        grid-row: 2/4;

        justify-self: center;
        align-self: end;

        width: 60%;
        height: auto;

        transform: translateY(-27%) translateX(5%);
    }

    .casillero:hover img {
        transform: scale(1.15);
        filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.5));
    }
</style>
