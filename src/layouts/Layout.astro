---
import { ClientRouter } from "astro:transitions";
const { title } = Astro.props;
import Preloads from "./Preloads.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <Preloads />
        <meta name="generator" content={Astro.generator} />
        <title>Mamarracho</title>
        <ClientRouter />
    </head>
    <body>
        <slot />
    </body>
</html>

<style is:global>
    @font-face {
        font-family: "Papiro";
        src: url("/FUENTES/LinLibertine_R_G.woff2") format("woff2");
        font-display: swap;
        font-weight: normal;
        font-style: normal;
    }

    @font-face {
        font-family: "Papiro";
        src: url("/FUENTES/LinLibertine_RB_G.woff2") format("woff2");
        font-display: swap;
        font-weight: bold;
        font-style: normal;
    }

    @font-face {
        font-family: "Papiro";
        src: url("/FUENTES/LinLibertine_RI_G.woff2") format("woff2");
        font-display: swap;
        font-weight: normal;
        font-style: italic;
    }

    @font-face {
        font-family: "Papiro";
        src: url("/FUENTES/LinLibertine_RBI_G.woff2") format("woff2");
        font-display: swap;
        font-weight: bold;
        font-style: italic;
    }

    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }

    @media (orientation: portrait) {
        html::before {
            content: "Girá tu celular";
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #3f133a;
            color: rgba(255, 195, 77, 1);
            font-size: 4rem;
            font-family: "Papiro", serif;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 999999;
        }
    }

    @keyframes pulsoGlow {
        0% {
            filter: drop-shadow(0 0 0px rgba(0, 123, 255, 0.7));
        }
        50% {
            filter: drop-shadow(0 0 5px rgba(255, 195, 77, 1));
        }
        100% {
            filter: drop-shadow(0 0 0px rgba(0, 123, 255, 0));
        }
    }
</style>
