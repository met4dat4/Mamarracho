---
import LottieAnimation from "astro-integration-lottie/Lottie.astro";
import background from "../assets/Main/fondo-mantel.png";
import tablero from "../assets/Main/tablero.png";
import tarjeta from "../assets/Main/tarjeta.svg";
---

<div class="container">
    <img id="background" src={background.src} alt="" fetchpriority="high" />
    <main>
        <div class="tarjeta">
            <img
                id="tarjeta-izq"
                src={tarjeta.src}
                alt=""
                fetchpriority="high"
            />
        </div>
        <div id="tablero">
            <img src={tablero.src} alt="" fetchpriority="high" />
            <!-- <div style="width: 200px; height: 150px;">
        <LottieAnimation src="/lottie-lego.json" autoplay="visible" />
    </div> -->
        </div>
        <div class="tarjeta">
            <img
                id="tarjeta-der"
                src={tarjeta.src}
                alt=""
                fetchpriority="high"
            />
        </div>
    </main>
</div>

<style>
    main {
        display: flex;
        justify-content: center;
        align-items: center;
        filter: blur(0px);
    }

    #background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -2;
        filter: blur(0px);
    }
    #tablero {
        display: flex;
        justify-content: center;
        align-items: center;
    }
    #tablero img {
        height: 100vh;
        filter: blur(0px);
    }

    .tarjeta img {
        height: 20vh;
        width: auto;
    }

    .tarjeta img:hover {
        filter: drop-shadow(0 0 5px rgba(232, 217, 102, 1));
        transform: scale(1.5);
    }

    #tarjeta-izq {
        transform: rotate(90deg);
    }

    #tarjeta-der {
        transform: rotate(-90deg);
    }
</style>
